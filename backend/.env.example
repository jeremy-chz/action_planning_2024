# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter .env

# Clé secrète JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Compte administrateur (créé automatiquement au premier démarrage)
ADMIN_LOGIN=action-admin
ADMIN_PASSWORD=change-me

# Base de données (laisser vide pour SQLite local)
# DATABASE_URL=postgresql://user:password@host/dbname

# Clé API Anthropic (pour le scan de photos)
# ANTHROPIC_API_KEY=sk-ant-...
